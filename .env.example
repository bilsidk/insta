PORT=4000
DATABASE_URL=postgres://user:pass@localhost:5432/insta_growth
JWT_SECRET=change-this-to-a-long-random-string
OWNER_EMAIL=your@email.com

# Public URL of this server (used in OAuth redirects — no trailing slash)
PUBLIC_BASE_URL=https://insta-production-91be.up.railway.app

# Instagram/Facebook App credentials
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret
INSTAGRAM_REDIRECT_URI=https://insta-production-91be.up.railway.app/auth/instagram/callback

# Email alerts via Resend
RESEND_API_KEY=re_your_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" on Railway/Neon to allow self-signed TLS certs
DB_SSL_NO_VERIFY=true
